# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NVIDIA_API_KEY: Required for NVIDIA NIM AI integration (e.g. nvapi-...)
# Get free API credits at https://build.nvidia.com
NVIDIA_API_KEY="nvapi-YOUR_NVIDIA_KEY_HERE"


# ALLOW_REGISTRATION: set to false to close public sign-up (the first account can always be created).
# ALLOW_REGISTRATION=false

# SESSION_SECRET: key that signs login cookies (32+ characters). If unset, one is generated in data/.
# SESSION_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# Most settings below (NVIDIA key, Razorpay, SMTP email, APP_URL, ALLOW_REGISTRATION) can instead be set by the
# admin on the Settings page (/settings). Values saved there take priority over this file.

# RAZORPAY: online payments for message plans (see README → "Plans & Razorpay payments").
# Fill in all three. While they are empty the Pricing page shows "Payments coming soon".
# Key id + secret: Razorpay Dashboard → Account & Settings → API Keys (rzp_test_... for testing, rzp_live_... for real payments).
# Webhook secret: any long random text; enter the same value when adding the webhook in the Razorpay Dashboard.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
